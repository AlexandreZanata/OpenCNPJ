# /etc/opencnpj/env (mode 0600, owner root). Never commit the real file.
OPENCNPJ_PUBLIC_URL=https://api.example.com
# Any SMTP server you already have (self-hosted, your domain's mailbox provider, ...).
# Without it, e-mails are written to /var/lib/opencnpj/outbox/.
OPENCNPJ_SMTP_URL=smtps://user:password@smtp.example.com:465
OPENCNPJ_MAIL_FROM=OpenCNPJ <no-reply@example.com>
